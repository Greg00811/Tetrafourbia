  m_Script: {fileID: 11500000, guid: 9af6d135f117f114abb17efab4b88716, type: 3}
  m_Name: AfterSecondBoss
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  defaultSpeakerName: Quade (Therapy AI Assistant)
  defaultNpcSprite: {fileID: 21300000, guid: 2c3aec1d7ff49bf4ea021d689a4fe10a, type: 3}
  lines:
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: This.... can't be.... You defeated me, Quade.
    npcSprite: {fileID: 0}
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: The "e" was silent, in case you were wondering.
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: Well, glad we could work out a solution to your little problem!
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: I'll send Doctor Greg a notice -- you passed your evaluation!
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: Those minigames I generated for you before are still here, should you ever
      need to face them again. Don't worry, I believe you're cured.
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: Goodbye, friend!
    npcSprite: {fileID: 0}
