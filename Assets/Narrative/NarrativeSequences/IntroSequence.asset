MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9af6d135f117f114abb17efab4b88716, type: 3}
  m_Name: IntroSequence
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  defaultSpeakerName: Quade (Therapy AI Assistant)
  defaultNpcSprite: {fileID: 21300000, guid: 2c3aec1d7ff49bf4ea021d689a4fe10a, type: 3}
  lines:
  - speakerName: Quade (Therapy AI Assistant)
    text: Hello! I'm Quade, your science-backed, trustworthy Therapy AI. Doctor Greg,
      your therapist, has already sent me your file for analysis.
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: What you appear to be suffering from is a severe case of Tetraphobia, the
      fear of the number... well, it's the one after three. We haven't begun trials
      yet, so I will refrain from naming that number just yet.
    npcSprite: {fileID: 0}
  - speakerName: Quade (Therapy AI Assistant)
    text: I have prepared a sequence of brief tests to assist you while you overcome
      your fear. I bet you can guess how many there are!
    npcSprite: {fileID: 0}
