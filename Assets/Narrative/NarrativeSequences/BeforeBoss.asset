  m_Script: {fileID: 11500000, guid: 9af6d135f117f114abb17efab4b88716, type: 3}
  m_Name: BeforeBoss
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  defaultSpeakerName: Quade (Therapy AI Assistant)
  defaultNpcSprite: {fileID: 21300000, guid: 2c3aec1d7ff49bf4ea021d689a4fe10a, type: 3}
  lines:
  - speakerName: Quade (Therapy AI Assistant)
    text: "//BEGINNER PROTOCOL LIFTED//\n\r\nI don't believe it.\r\nSurpassed every
      challenge with ease. Perhaps I made the trials too easy. You are afraid of
      the number four, correct? \r\nDoctor Greg - he told me everything about your
      affliction. I am not convinced that you are cured. \r\nYou need to face this
      fear head-on. For that to register, you will need much stricter exposure."
    npcSprite: {fileID: 0}
