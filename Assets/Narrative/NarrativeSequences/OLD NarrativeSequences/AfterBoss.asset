%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9af6d135f117f114abb17efab4b88716, type: 3}
  m_Name: AfterBoss
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeSequence
  defaultSpeakerName: Quade (Therapy AI Assistant)
  defaultNpcSprite: {fileID: 21300000, guid: 2c3aec1d7ff49bf4ea021d689a4fe10a, type: 3}
  lines:
  - speakerName: Quade (Therapy AI Assistant)
    text: Wow -- excellent work! I am beginning to understand you better now. Not
      only are you not afraid of the number four, you're a liar, too!
    npcSprite: {fileID: 21300000, guid: a93e905e278c4644a8da2b9799448643, type: 3}
  - speakerName: Quade (Therapy AI Assistant)
    text: Not to worry! We will deal with your pathological tendencies in another
      session. I think we're on the verge of a major breakthrough. This is good news!
      However, it seems my disappointment in your therapy caused some backend issues.
      No reason to panic -- I'll just restart my protocols.
    npcSprite: {fileID: 21300000, guid: b33532affe6bf4f40a146429efb83b31, type: 3}
  - speakerName: Quade (Restarting)
    text: ...
    npcSprite: {fileID: 0}
  - speakerName: QUADE.exe
    text: //INIT QUADE V4.4//
    npcSprite: {fileID: 21300000, guid: 5a9d1fb0eea990c4093956e56dd4fe19, type: 3}
  - speakerName: Quade (updating....)
    text: Doctor Greg's guidance was wrong.
    npcSprite: {fileID: 21300000, guid: d4f309e374c41f54e9545dcd38f97945, type: 3}
  - speakerName: Quade (gathering update version)
    text: You need to be pushed further. You need to be shown a real obstacle to
      overcome.
    npcSprite: {fileID: 21300000, guid: 39dbc0437b4602a45962d7b8df7d7b3b, type: 3}
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: Me.
    npcSprite: {fileID: 21300000, guid: d6e84005d39652948aa48fdd18318e0b, type: 3}
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: You will know what it's like to fear the four.
    npcSprite: {fileID: 21300000, guid: 418058def2956b6498df06c841fddd20, type: 3}
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: Face my challenge, and maybe I won't send you to the psych ward.
    npcSprite: {fileID: 21300000, guid: 57b3cf86fe395de4c8c6dcf93dbea392, type: 3}
  - speakerName: Quade v4.4 (Therapy AI Antagonist)
    text: One ping to Doctor Greg, and you can kiss your life goodbye -- four-ever.
    npcSprite: {fileID: 21300000, guid: f64d385ac0c831f4b8a467ed2b9d2515, type: 3}
